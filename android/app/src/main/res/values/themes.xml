<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zree" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zree_surface</item>
        <item name="android:navigationBarColor">@color/zree_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Zree.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zree_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Zree</item>
    </style>
</resources>
